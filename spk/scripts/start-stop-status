#!/bin/sh
# Bind Mount Manager has no daemon of its own (the root helper is started by
# a Task Scheduler task), so this only makes sure the data folders exist.
VAR="${SYNOPKG_PKGVAR:-/var/packages/BindMountManager/var}"
case "$1" in
  start)
    mkdir -p "$VAR/spool" 2>/dev/null
    [ -f "$VAR/mounts.conf" ] || : > "$VAR/mounts.conf"
    exit 0
    ;;
  stop) exit 0 ;;
  status) exit 0 ;;
  log) exit 0 ;;
esac
exit 0
